# --- OpenAI-compatible LLM access (required for --backend openai) ---
OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Model routing (CLAUDE.md: fast extraction vs. high-level retrieval) ---
LLM_EXTRACT_MODEL=gpt-4o-mini
LLM_QUERY_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Paths ---
WORKING_DIR=./rag_storage
DATA_DIR=./data
CANVAS_PATH=./output/knowledge_graph.canvas

# --- Extraction tuning ---
SUMMARY_LANGUAGE=English
MAX_GLEANING=1
COSINE_THRESHOLD=0.2
