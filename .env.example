# --- OpenAI-compatible LLM access (required for --backend openai) ---
OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Model routing (CLAUDE.md: fast extraction vs. high-level retrieval) ---
LLM_EXTRACT_MODEL=gpt-4o-mini
LLM_QUERY_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Paths ---
WORKING_DIR=./rag_storage
DATA_DIR=./data
CANVAS_PATH=./output/knowledge_graph.canvas

# --- Extraction tuning ---
SUMMARY_LANGUAGE=English
MAX_GLEANING=1
COSINE_THRESHOLD=0.2
# Merge near-duplicate entities after each ingest run (1/0)
RECONCILE_GRAPH=1

# --- External metadata (OpenAlex first, Crossref fallback) ---
# Ground LLM-profiled titles/authors/years/venues/references in the catalogues (1/0)
METADATA_LOOKUP=1
# Optional contact e-mail for the APIs' polite pools (faster rate limits). Off by default.
# METADATA_MAILTO=you@example.org
# Cap on catalogue references appended per paper (in-text references are always kept)
METADATA_MAX_REFERENCES=40
